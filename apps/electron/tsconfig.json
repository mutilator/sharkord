{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "noEmit": false,
    "noImplicitAny": true,
    "paths": {
      "@/*": [
        "./src/renderer/*",
        "../client/src/*"
      ],
      "@sharkord/shared": [
        "../../packages/shared/src"
      ],
      "@sharkord/ui": [
        "../../packages/ui/src"
      ],
      "@sharkord/plugin-sdk": [
        "../../packages/plugin-sdk/src"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
