{
  "name": "electron-client",
  "private": true,
  "version": "0.0.5",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "postinstall": "rm -rf node_modules/@sharkord/shared* || true",
    "dev": "tsc --project tsconfig.preload.json && tsc --project tsconfig.main.json && node -r ./scripts/polyfill-abortcontroller.cjs ./node_modules/.bin/concurrently --kill-others \"vite --port 5173\" \"tsc --project tsconfig.main.json --watch --preserveWatchOutput\" \"wait-on http://localhost:5173 && ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "dev:main": "tsc src/main/main.ts --noEmit",
    "build": "vite build && tsc --project tsconfig.preload.json && tsc --project tsconfig.main.json",
    "dist-win": "bun run postinstall && node ./scripts/before-pack.cjs && (electron-builder --win; exitCode=$?; node ./scripts/after-pack.cjs; exit $exitCode)",
    "dist-linux": "bun run postinstall && node ./scripts/before-pack.cjs && (electron-builder --linux; exitCode=$?; node ./scripts/after-pack.cjs; exit $exitCode)",
    "dist": "bun run postinstall && node ./scripts/before-pack.cjs && (electron-builder --win --linux; exitCode=$?; node ./scripts/after-pack.cjs; exit $exitCode)",
    "lint": "eslint ./src --ext ts,tsx",
    "lint:fix": "eslint ./src --ext ts,tsx --report-unused-disable-directives --fix",
    "check-types": "tsc --noEmit --project tsconfig.json",
    "format": "prettier --write \"**/*.ts*\" --config ./.prettierrc.json",
    "format:check": "prettier --check \"**/*.ts*\" --config ./.prettierrc.json",
    "magic": "bun --bun run lint:fix && bun --bun run format && bun --bun run check-types"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/dom": "^1.7.4",
    "@radix-ui/react-avatar": "^1.1.10",
    "@reduxjs/toolkit": "^2.9.0",
    "@sharkord/ui": "workspace:*",
    "@tailwindcss/vite": "^4.1.13",
    "@tiptap/core": "^3.7.2",
    "@tiptap/extension-emoji": "^3.7.2",
    "@tiptap/extension-link": "^3.20.0",
    "@tiptap/pm": "^3.19.0",
    "@tiptap/react": "^3.7.2",
    "@tiptap/starter-kit": "^3.7.2",
    "@tiptap/suggestion": "^3.19.0",
    "@trpc/client": "^11.6.0",
    "@types/lodash-es": "^4.17.12",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "eslint-plugin-react-you-might-not-need-an-effect": "^0.7.0",
    "filesize": "^11.0.13",
    "html-react-parser": "^5.2.6",
    "lodash-es": "^4.17.21",
    "lucide-react": "^0.544.0",
    "mediasoup-client": "^3.18.0",
    "prosemirror-view": "^1.41.6",
    "re-reselect": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-lite-youtube-embed": "^2.5.6",
    "react-redux": "^9.2.0",
    "react-tweet": "^3.2.2",
    "react-virtuoso": "^4.18.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "electron-store": "^10.0.0",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "concurrently": "^9.2.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.4.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7",
    "prettier": "^3.4.2",
    "prettier-plugin-organize-imports": "^4.0.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.sharkord.client",
    "productName": "Sharkord",
    "directories": {
      "app": "./",
      "buildResources": "assets",
      "output": "dist/electron"
    },
    "asarUnpack": [
      "node_modules/uiohook-napi/**/*"
    ],
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
